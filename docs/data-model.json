        {
          "name": "domain",
          "type": "string",
          "required": false
        },
        {
          "name": "sample_size",
          "type": "int",
          "required": false
        },
        {
          "name": "incentive_inr",
          "type": "int",
          "required": false
        },
        {
          "name": "reward_type",
          "type": "enum",
          "required": false,
          "values": [
            "upi_cash",
            "amazon_voucher",
            "myntra_voucher",
            "mobile_recharge"
          ]
