          "required": false
        },
        {
          "name": "closed_at",
          "type": "timestamp",
          "required": false
        },
        {
          "name": "synthesized_at",
          "type": "timestamp",
          "required": false
        },
        {
          "name": "headline",
          "type": "string",
          "required": false
        },
        {
          "name": "summary",
          "type": "string",
          "required": false
        },
        {
          "name": "confidence_pct",
          "type": "decimal",
          "required": false
        },
        {
          "name": "share_token",
          "type": "string",
          "required": false
        },
        {
          "name": "created_at",
          "type": "timestamp",
          "required": true
        },
        {
          "name": "updated_at",
          "type": "timestamp",
          "required": true
        },
        {
          "name": "recruitment_boost",
          "type": "int",
          "required": false
        }
      ]
    },
    {
      "name": "AudienceCriterion",
      "layer": "runtime",
