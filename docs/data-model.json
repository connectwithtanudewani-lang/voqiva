{
  "product": "Voqiva",
  "version": "3.0",
  "conventions": {
    "money": "integer INR (whole rupees)",
    "ids": "uuid",
    "time": "UTC timestamp"
  },
  "entities": [
    {
      "name": "PromptTemplate",
      "layer": "seed",
      "purpose": "Home 'Try asking' chips and Define-Objective scenario starters",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "required": true,
          "primaryKey": true
        },
        {
          "name": "label",
          "type": "string",
          "required": true
        },
        {
          "name": "prompt_text",
          "type": "string",
          "required": true
        },
        {
          "name": "placement",
          "type": "enum",
          "required": true,
          "values": [
            "home_suggestion",
            "scenario_starter"
          ]
        }
      ]
    },
    {
      "name": "FeeSchedule",
      "layer": "seed",
      "purpose": "Platform fees shown in the budget breakdown before launch",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "required": true,
          "primaryKey": true
        },
        {
          "name": "kind",
          "type": "enum",
          "required": true,
          "values": [
            "synthesis_fee",
            "disbursement_fee"
          ]
        },
        {
          "name": "amount_inr",
          "type": "int",
          "required": true
        }
      ]
    },
    {
      "name": "AudienceSegment",
      "layer": "seed",
      "purpose": "Ready-made panel audience (Gen Z, College students, Working professionals…) with its incentive rate and verification method",
      "fields": [
        {
          "name": "key",
          "type": "string",
          "required": true,
          "primaryKey": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "age_range",
          "type": "string",
          "required": true
        },
        {
          "name": "description",
          "type": "string",
          "required": true
        },
        {
          "name": "rate_inr",
          "type": "int",
          "required": true
        },
        {
          "name": "verification",
          "type": "string",
          "required": true
        },
        {
          "name": "rules",
          "type": "json",
          "required": true
        }
      ]
    },
    {
      "name": "Person",
      "layer": "seed+runtime",
      "purpose": "Voqiva verified panelist (seed, no cohort_import_id) or imported brand customer (runtime)",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "required": true,
          "primaryKey": true
        },
        {
          "name": "cohort_import_id",
          "type": "uuid",
          "required": false,
          "references": "CohortImport.id"
        },
        {
          "name": "full_name",
          "type": "string",
          "required": true
        },
        {
          "name": "phone",
          "type": "string",
          "required": true
        },
        {
          "name": "gender",
          "type": "enum",
          "required": false,
          "values": [
            "male",
            "female",
            "other"
          ]
        },
        {
          "name": "birth_date",
          "type": "date",
          "required": false
        },
        {
          "name": "city",
          "type": "string",
          "required": false
        },
        {
          "name": "occupation",
          "type": "string",
          "required": false
        },
        {
          "name": "attributes",
          "type": "json",
          "required": false
        },
        {
          "name": "upi_vpa",
          "type": "string",
          "required": false
        },
        {
          "name": "aadhaar_verified_at",
          "type": "timestamp",
          "required": false
        },
        {
          "name": "linkedin_verified_at",
          "type": "timestamp",
          "required": false
        },
        {
          "name": "upi_verified_at",
          "type": "timestamp",
          "required": false
        },
        {
          "name": "segments",
          "type": "json",
          "required": false,
          "note": "stored in attributes.segments; also attributes.source, joined_at, quality_score, studies_30d"
        }
      ]
    },
    {
      "name": "Workspace",
      "layer": "runtime",
      "purpose": "A brand account, e.g. UrbanKhaadi D2C",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "required": true,
          "primaryKey": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "auto_reload_mandate_ref",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "User",
      "layer": "runtime",
      "purpose": "A person who logs in",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "required": true,
          "primaryKey": true
        },
        {
          "name": "full_name",
          "type": "string",
          "required": true
        },
        {
          "name": "email",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "Membership",
      "layer": "runtime",
      "purpose": "User's seat in a workspace (powers the brand switcher)",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "required": true,
          "primaryKey": true
        },
        {
          "name": "workspace_id",
          "type": "uuid",
          "required": true,
          "references": "Workspace.id"
        },
        {
          "name": "user_id",
          "type": "uuid",
          "required": true,
          "references": "User.id"
        },
        {
          "name": "title",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "WalletTransaction",
      "layer": "runtime",
      "purpose": "Ledger; wallet balance is the sum of these",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "required": true,
          "primaryKey": true
        },
        {
          "name": "workspace_id",
          "type": "uuid",
          "required": true,
          "references": "Workspace.id"
        },
        {
          "name": "study_id",
          "type": "uuid",
          "required": false,
          "references": "Study.id"
        },
        {
          "name": "kind",
          "type": "enum",
          "required": true,
          "values": [
            "topup",
            "incentive_reserve",
            "synthesis_fee",
            "disbursement_fee",
            "refund",
            "recruitment_boost"
          ]
        },
        {
          "name": "amount_inr",
          "type": "int",
          "required": true
        },
        {
          "name": "created_at",
          "type": "timestamp",
          "required": true
        }
      ]
    },
    {
      "name": "CohortImport",
      "layer": "runtime",
      "purpose": "A first-party customer list pulled from Shopify / Klaviyo / CSV",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "required": true,
          "primaryKey": true
        },
        {
          "name": "workspace_id",
          "type": "uuid",
          "required": true,
          "references": "Workspace.id"
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "source",
          "type": "enum",
          "required": true,
          "values": [
            "shopify",
            "klaviyo",
            "csv"
          ]
        },
        {
          "name": "created_at",
          "type": "timestamp",
          "required": true
        }
      ]
    },
    {
      "name": "Study",
      "layer": "runtime",
      "purpose": "Objective + AI plan + lifecycle + executive synthesis (one record, no separate Report)",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "required": true,
          "primaryKey": true
        },
        {
          "name": "workspace_id",
          "type": "uuid",
          "required": true,
          "references": "Workspace.id"
        },
        {
          "name": "created_by",
          "type": "uuid",
          "required": true,
          "references": "User.id"
        },
        {
          "name": "parent_study_id",
          "type": "uuid",
          "required": false,
          "references": "Study.id"
        },
        {
          "name": "cohort_import_id",
          "type": "uuid",
          "required": false,
          "references": "CohortImport.id"
        },
        {
          "name": "audience_source",
